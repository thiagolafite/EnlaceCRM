# Dependências
node_modules/
backend/node_modules/
frontend/node_modules/

# Builds e bundles
dist/
build/
backend/dist/
frontend/dist/
*.tsbuildinfo
.vercel/

# Variáveis de ambiente sensíveis
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Bancos de dados locais e arquivos SQLite
*.db
*.db-journal
*.sqlite
*.sqlite-journal
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.js
prisma/*.js

# Logs e depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editores e IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Temporários, testes e caches
.cache/
.vite/
frontend/.vite/
.temp/
tmp/
coverage/
