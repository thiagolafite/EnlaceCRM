# ==========================================
# ENLACE CRM — VARIÁVEIS DE AMBIENTE (BACKEND)
# ==========================================

PORT=3333
NODE_ENV=development

# URL do Frontend
APP_URL=http://localhost:5173

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3333

# ==========================================
# BANCO DE DADOS (POSTGRESQL / SUPABASE)
# ==========================================
# 1. DATABASE_URL (Connection Pooler - porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Conexão Direta para Migrações - porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# SEGURANÇA & AUTENTICAÇÃO
# ==========================================
# Chave JWT (mínimo de 32 caracteres)
JWT_SECRET="substitua_por_uma_chave_secreta_com_minimo_32_chars"

# Segredo para execução de rotinas cron internas (mínimo 16 caracteres)
CRON_SECRET="substitua_por_um_segredo_cron_minimo_16_chars"

# E-mail do Administrador Master global
MASTER_EMAIL="master@suaempresa.com.br"

# ==========================================
# BOOTSTRAP INICIAL (Opcional - para seed)
# ==========================================
BOOTSTRAP_ADMIN_EMAIL="admin@suaempresa.com.br"
BOOTSTRAP_ADMIN_PASSWORD="sua_senha_segura_minimo_10_chars"
