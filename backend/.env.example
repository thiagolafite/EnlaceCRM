# ==========================================
# ENLACE CRM — VARIÁVEIS DE AMBIENTE
# ==========================================

# Porta da API do backend
PORT=3333

# Banco de dados (SQLite local ou PostgreSQL em produção)
DATABASE_URL="file:./dev.db"
# Para PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/enlace?schema=public"

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET="enlace_crm_super_secret_jwt_key_2026"

# Ambiente de execução (development | production)
NODE_ENV="development"
