datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  tradeName          String?            @default("")
  document           String?            @default("")
  status             String             @default("TRIAL") // TRIAL, ACTIVE, SUSPENDED, CANCELED
  plan               String             @default("STARTER") // STARTER, PRO, ENTERPRISE
  maxClients         Int                @default(500)
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  settings           CompanySettings?
  users              User[]
  clients            Client[]
  alerts             Alert[]
  templates          MessageTemplate[]
  commemorativeDates CommemorativeDate[]
  systemLogs         SystemLog[]
}

model CompanySettings {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // CallMeBot WhatsApp Notification Settings (para o dono/operador da empresa)
  ownerWhatsappPhone    String?  @default("")
  callmebotApiKey       String?  @default("")
  callmebotApiKeyIv     String?
  callmebotApiKeyTag    String?
  callmebotEnabled      Boolean  @default(true)
  callmebotSimulateMode Boolean  @default(false)

  // Scheduler Settings por empresa
  schedulerHour         Int      @default(6) // 06:00
  schedulerMinute       Int      @default(0)
  schedulerEnabled      Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // MASTER, ADMIN, OPERATOR
  status       String   @default("PENDING_APPROVAL") // ACTIVE, PENDING_APPROVAL, BLOCKED
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, status])
}

model Client {
  id                String         @id @default(uuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  document          String?        // CPF ou CNPJ
  email             String?
  phone             String?        // Formato E.164 (ex: +5511999999999)
  companyName       String?        // Empresa onde trabalha / PJ
  birthDate         DateTime?      // Data de nascimento
  
  // Endereço do Cliente
  zipCode           String?        // CEP (ex: 41810-010)
  address           String?        // Logradouro / Rua / Avenida
  addressNumber     String?        // Número
  addressComplement String?        // Complemento (Apto, Sala, Bloco, etc.)
  neighborhood      String?        // Bairro
  city              String?        // Cidade
  state             String?        // Estado / UF

  status            String         @default("ACTIVE") // ACTIVE, INACTIVE
  
  // Segmentação e Perfil Familiar para Datas Comemorativas
  gender            String?        @default("NOT_SPECIFIED") // FEMALE, MALE, OTHER, NOT_SPECIFIED
  isMother          Boolean        @default(false)           // É Mãe
  isFather          Boolean        @default(false)           // É Pai
  profession        String?                                  // Profissão ou Cargo (ex: Médico, Advogado, Professor)

  lgpdConsent       Boolean        @default(true) // Opt-in de comunicação
  lgpdConsentDate   DateTime       @default(now())
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  familyMembers     FamilyMember[]
  alerts            Alert[]

  @@index([companyId, status])
}

model FamilyMember {
  id                  String        @id @default(uuid())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  gender              String?       @default("NOT_SPECIFIED") // FEMALE, MALE, OTHER, NOT_SPECIFIED
  relationship        String        // MOTHER, FATHER, SON, DAUGHTER, SPOUSE, BROTHER, SISTER, GRANDFATHER, GRANDMOTHER, OTHER
  birthDate           DateTime      // Data de nascimento para cálculo do aniversário
  phone               String?       // Opcional conforme princípio da minimização LGPD
  email               String?       // Opcional conforme princípio da minimização LGPD
  
  // Endereço do Familiar
  sameAddressAsClient Boolean       @default(false)
  zipCode             String?
  address             String?
  addressNumber       String?
  addressComplement   String?
  neighborhood        String?
  city                String?
  state               String?

  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  alerts              Alert[]
}

model CommemorativeDate {
  id             String            @id @default(uuid())
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String            // ex: "Dia das Mães", "Natal", "Dia do Cliente"
  day            Int               // 1-31
  month          Int               // 1-12
  year           Int?              // Nulo para anual recorrente, ou número específico
  description    String?
  category       String            @default("FIXED") // FIXED, CULTURAL, CORPORATE
  targetAudience String            @default("ALL_CLIENTS") // ALL_CLIENTS, MOTHERS_ONLY, FATHERS_ONLY, CUSTOM
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  templates      MessageTemplate[]
  alerts         Alert[]

  @@index([companyId, active])
}

model MessageTemplate {
  id                  String             @id @default(uuid())
  companyId           String?
  company             Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String             // ex: "Aniversário do Cliente"
  eventType           String             // CLIENT_BIRTHDAY, FAMILY_BIRTHDAY, FIXED_DATE
  channel             String             @default("WHATSAPP")
  commemorativeDateId String?
  commemorativeDate   CommemorativeDate? @relation(fields: [commemorativeDateId], references: [id], onDelete: SetNull)
  subject             String?            // Assunto opcional
  content             String             // Mensagem com interpolação {{nome_cliente}}, etc.
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  alerts              Alert[]

  @@index([companyId, eventType])
}

model Alert {
  id                  String             @id @default(uuid())
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  familyMemberId      String?
  familyMember        FamilyMember?      @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  commemorativeDateId String?
  commemorativeDate   CommemorativeDate? @relation(fields: [commemorativeDateId], references: [id], onDelete: SetNull)
  templateId          String?
  template            MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  eventType           String             // CLIENT_BIRTHDAY, FAMILY_BIRTHDAY, FIXED_DATE
  clientName          String
  clientPhone         String?
  targetName          String             // Nome do aniversariante (cliente ou familiar)
  contextDescription  String             // Ex: "Aniversário do Cliente (36 anos)" ou "Aniversário da Mãe"
  renderedMessage     String             // Texto final pronto para envio no WhatsApp
  
  // Status da notificação enviada ao dono via CallMeBot
  notificationStatus  String             @default("PENDING") // PENDING, SENT, FAILED, SIMULATED
  notificationError   String?
  
  // Controle de envio manual para o cliente final
  sentToClientManual  Boolean            @default(false)
  sentToClientManualAt DateTime?
  
  alertDate           DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId, alertDate])
  @@index([companyId, notificationStatus])
}

model QueueJob {
  id           String    @id @default(uuid())
  type         String    // NOTIFY_OWNER, SCAN_DATES
  payload      String    // JSON string
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  error        String?
  scheduledFor DateTime  @default(now())
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SystemLog {
  id          String   @id @default(uuid())
  level       String   @default("INFO") // INFO, WARN, ERROR, SECURITY, CRITICAL
  category    String   // AUTH, DATABASE, API, AUTOMATION, SECURITY, SYSTEM
  action      String   // LOGIN_FAILED, LOGIN_SUCCESS, UNAUTHORIZED_ACCESS, SERVER_ERROR, CRON_RUN, PASSWORD_RESET, etc.
  message     String
  details     String?  // JSON string ou stack trace
  ipAddress   String?
  userAgent   String?
  userId      String?
  userEmail   String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([companyId, createdAt])
}
